# Exemple local uniquement : remplacez SECRET_KEY avant tout déploiement.
SECRET_KEY=replace-this-with-a-random-secret-of-32-bytes-or-more

# Base locale SQLite. En production, indiquez l'URL PostgreSQL fournie par l'hébergeur.
DATABASE_URL=sqlite:///./telemed_secure.db

# Facultatif en local. En production, utilisez une clé AES-256 dédiée, encodée en base64.
AES_ENCRYPTION_KEY=

# Facultatif si l'interface est servie depuis un autre domaine.
CORS_ORIGINS=

# Mode démonstration locale : expose /api/dev/test-accounts (mots de passe et
# codes MFA en clair, sans SMTP). À laisser à false partout ailleurs.
ENABLE_TEST_ACCOUNTS=false
